# Configuración de la Base de Datos PostgreSQL
# DB_HOST debe ser el nombre del servicio en docker-compose.yml ("db"),
# no "localhost", porque el backend se conecta desde otro contenedor.
DB_HOST=db
DB_PORT=5432
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_password_aqui
DB_NAME=foodaware_db

# Configuración del Backend (NestJS)
PORT=3000

# Configuración del Servicio de Inteligencia Artificial (FastAPI)
# Igual que DB_HOST: debe ser el nombre del servicio en docker-compose.yml.
PYTHON_API_URL=http://python-service:8000

# Llamadas del backend a FastAPI (GET /search): timeout por intento en
# milisegundos y reintentos extra ante 502, 503, 504 o timeout. Si fallan
# todos, el backend responde con su respaldo desde la base.
PYTHON_API_TIMEOUT_MS=2000
PYTHON_API_REINTENTOS=2

# Nivel de los logs JSON del servicio de IA: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO

# Simulación de errores en los endpoints del contrato del servicio de IA (solo desarrollo).
# Con true, el header X-Simular-Error fuerza respuestas 503, 504 o 500.
SIMULAR_ERRORES_HABILITADO=false

# Open Food Facts (fuente web). OFF_USER_AGENT es obligatorio, con formato
# AppName/Version (ContactEmail); usa un correo real de contacto del equipo.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=FoodAware/0.1 (correo@ejemplo.com)
OFF_TIMEOUT_SEGUNDOS=10

# Máximo que una petición HTTP (GET /products) espera al limitador de tasa;
# si tendría que esperar más, responde 503. La ingesta sí espera lo necesario.
LIMITADOR_ESPERA_MAX_SEGUNDOS=3

# Caché local SQLite del servicio de IA. En Docker Compose vive en el volumen
# python_cache montado en /data, para que no se pierda al reiniciar.
CACHE_DB_PATH=/data/foodaware-cache.sqlite3

# Si la caché está vacía al arrancar, carga la semilla del corpus
# (python-service/semilla/corpus-off.json.gz) antes de cualquier ingesta, sin
# llamar a Open Food Facts. Pensado para Render, donde el disco es efímero.
CARGAR_SEMILLA_SI_VACIA=true

# Estrategia de actualización: ingesta inicial si la caché está vacía al
# arrancar, refresco periódico y TTL de cada producto al pedirlo.
INGESTA_AL_INICIAR=true
INGESTA_INTERVALO_HORAS=24
CACHE_TTL_HORAS=72

# Corpus de las ingestas automáticas: categorías de Open Food Facts
# (taxonomía en:, separadas por comas; vacío = sin filtrar) y tope de
# productos, que se reparte entre ellas (máximo 500).
INGESTA_CATEGORIAS=en:biscuits,en:dairies,en:breads,en:chocolates,en:breakfast-cereals,en:salty-snacks,en:plant-based-milk-alternatives
INGESTA_MAX_PRODUCTOS=500

# Configuración de JWT
JWT_SECRET=tu_clave_secreta_aqui