{
  "openapi": "3.1.0",
  "info": {
    "title": "Analista de Alimentos FoodAware",
    "description": "Contrato entre FastAPI y NestJS de FoodAware. Productos, búsqueda e ingesta usan Open Food Facts y una caché local; las métricas de calidad se calculan desde la caché y las de evaluación, sobre el índice de búsqueda vigente.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Estado del servicio y de sus dependencias",
        "description": "200 con estado `ok` o `degradado` (el servicio responde desde la caché); 503 con estado `error` si la caché no responde. No consulta Open Food Facts: su estado sale de la última ingesta y de la última falla registrada.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          },
          "503": {
            "description": "La caché no responde (estado error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaSalud"
                }
              }
            }
          }
        }
      }
    },
    "/analizar": {
      "post": {
        "tags": [
          "analisis"
        ],
        "summary": "Analizar Producto",
        "operationId": "analizar_producto_analizar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{codigo_barras}": {
      "get": {
        "tags": [
          "productos"
        ],
        "summary": "Obtiene un producto por código de barras",
        "operationId": "obtener_producto_products__codigo_barras__get",
        "parameters": [
          {
            "name": "codigo_barras",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8,14}$",
              "description": "De 8 a 14 dígitos.",
              "title": "Codigo Barras"
            },
            "description": "De 8 a 14 dígitos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Producto"
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Parámetros o cuerpo inválidos (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "503": {
            "description": "Open Food Facts no disponible (SOURCE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "504": {
            "description": "Open Food Facts no respondió a tiempo (SOURCE_TIMEOUT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "busqueda"
        ],
        "summary": "Busca productos por texto con ranking de relevancia",
        "operationId": "buscar_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Texto a buscar.",
              "title": "Q"
            },
            "description": "Texto a buscar."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaBusqueda"
                }
              }
            }
          },
          "422": {
            "description": "Parámetros o cuerpo inválidos (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "503": {
            "description": "Open Food Facts no disponible (SOURCE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "504": {
            "description": "Open Food Facts no respondió a tiempo (SOURCE_TIMEOUT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          }
        }
      }
    },
    "/ingest/runs": {
      "post": {
        "tags": [
          "ingesta"
        ],
        "summary": "Inicia una ejecución de ingesta desde Open Food Facts",
        "description": "Requiere el header X-Clave-Ingesta con la clave interna; sin ella responde 403 antes de validar el cuerpo.",
        "operationId": "iniciar_ingesta_ingest_runs_post",
        "parameters": [
          {
            "name": "X-Clave-Ingesta",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave interna (variable INGESTA_CLAVE del servicio).",
              "title": "X-Clave-Ingesta"
            },
            "description": "Clave interna (variable INGESTA_CLAVE del servicio)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudIngesta"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenIngesta"
                }
              }
            }
          },
          "403": {
            "description": "Falta la clave interna o no es válida (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Parámetros o cuerpo inválidos (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "503": {
            "description": "Open Food Facts no disponible (SOURCE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          }
        }
      }
    },
    "/ingest/runs/latest": {
      "get": {
        "tags": [
          "ingesta"
        ],
        "summary": "Resumen de la última ejecución de ingesta",
        "operationId": "ultima_ingesta_ingest_runs_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenIngesta"
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics/quality": {
      "get": {
        "tags": [
          "metricas"
        ],
        "summary": "Métricas de calidad de los datos almacenados",
        "operationId": "metricas_calidad_metrics_quality_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasCalidad"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics/evaluation": {
      "get": {
        "tags": [
          "metricas"
        ],
        "summary": "Métricas de evaluación de la búsqueda (Precision@K y Recall@K)",
        "operationId": "metricas_evaluacion_metrics_evaluation_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasEvaluacion"
                }
              }
            }
          },
          "500": {
            "description": "Error interno (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllergenCode": {
        "type": "string",
        "enum": [
          "lacteos",
          "gluten",
          "huevo",
          "mani",
          "frutos_secos",
          "soya",
          "pescado",
          "crustaceos",
          "moluscos",
          "sesamo",
          "mostaza",
          "apio",
          "sulfitos",
          "altramuces"
        ],
        "title": "AllergenCode",
        "description": "Alérgenos de declaración obligatoria, con códigos sin tildes."
      },
      "Calidad": {
        "properties": {
          "es_valido": {
            "type": "boolean",
            "title": "Es Valido",
            "description": "Indica si el registro cumple las reglas mínimas.",
            "examples": [
              true
            ]
          },
          "problemas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Problemas",
            "description": "Problemas detectados durante la validación.",
            "examples": [
              [
                "sin_ingredientes",
                "sin_imagen"
              ]
            ]
          },
          "completitud": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Completitud",
            "description": "Fracción de campos relevantes presentes (0 a 1).",
            "examples": [
              0.85
            ]
          }
        },
        "type": "object",
        "required": [
          "es_valido",
          "completitud"
        ],
        "title": "Calidad",
        "description": "Resultado de la validación del registro."
      },
      "CodigoError": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "FORBIDDEN",
          "NOT_FOUND",
          "SOURCE_UNAVAILABLE",
          "SOURCE_TIMEOUT",
          "INTERNAL_ERROR"
        ],
        "title": "CodigoError",
        "description": "Códigos de error uniformes del contrato."
      },
      "DetalleCache": {
        "properties": {
          "productos": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Productos",
            "description": "Productos en la caché; nulo si no responde.",
            "examples": [
              812
            ]
          }
        },
        "type": "object",
        "title": "DetalleCache"
      },
      "DetalleError": {
        "properties": {
          "codigo": {
            "$ref": "#/components/schemas/CodigoError",
            "examples": [
              "NOT_FOUND"
            ]
          },
          "mensaje": {
            "type": "string",
            "minLength": 1,
            "title": "Mensaje",
            "examples": [
              "Producto 7802800716999 no encontrado"
            ]
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "description": "Valor del header X-Request-ID de la petición.",
            "examples": [
              "3f2b8c1e-9d4a-4e7b-8a6f-1c2d3e4f5a6b"
            ]
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje",
          "request_id"
        ],
        "title": "DetalleError"
      },
      "DetalleIndice": {
        "properties": {
          "cargado": {
            "type": "boolean",
            "title": "Cargado",
            "description": "El índice de búsqueda ya se construyó desde la caché.",
            "examples": [
              true
            ]
          },
          "productos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Productos",
            "examples": [
              812
            ]
          }
        },
        "type": "object",
        "required": [
          "cargado",
          "productos"
        ],
        "title": "DetalleIndice"
      },
      "DetalleOpenFoodFacts": {
        "properties": {
          "ultima_ingesta": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "completado",
                  "completado_con_errores",
                  "fallido"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultima Ingesta",
            "description": "Estado de la última ingesta terminada; nulo si nunca hubo una.",
            "examples": [
              "completado"
            ]
          },
          "ultima_ingesta_fin": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultima Ingesta Fin",
            "examples": [
              "2026-10-20T14:02:30Z"
            ]
          },
          "ultima_falla": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultima Falla",
            "description": "Última falla registrada de la fuente.",
            "examples": [
              "2026-10-20T13:10:00Z"
            ]
          }
        },
        "type": "object",
        "title": "DetalleOpenFoodFacts"
      },
      "DetalleSalud": {
        "properties": {
          "cache": {
            "$ref": "#/components/schemas/DetalleCache"
          },
          "indice": {
            "$ref": "#/components/schemas/DetalleIndice"
          },
          "openfoodfacts": {
            "$ref": "#/components/schemas/DetalleOpenFoodFacts"
          }
        },
        "type": "object",
        "required": [
          "cache",
          "indice",
          "openfoodfacts"
        ],
        "title": "DetalleSalud"
      },
      "DietLabel": {
        "type": "string",
        "enum": [
          "vegano",
          "vegetariano",
          "sin_gluten",
          "sin_lactosa"
        ],
        "title": "DietLabel",
        "description": "Etiquetas de dieta que el servicio puede inferir de un producto."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricasCalidad": {
        "properties": {
          "porcentaje_validos": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Porcentaje Validos",
            "description": "Válidos sobre recuperados en las ingestas terminadas.",
            "examples": [
              92.0
            ]
          },
          "porcentaje_duplicados": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Porcentaje Duplicados",
            "description": "Duplicados sobre válidos en las ingestas terminadas.",
            "examples": [
              5.0
            ]
          },
          "cobertura_ingredientes": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cobertura Ingredientes",
            "description": "Porcentaje de productos recuperados con ingredientes utilizables tras la limpieza.",
            "examples": [
              87.5
            ]
          },
          "antiguedad_promedio_horas": {
            "type": "number",
            "minimum": 0.0,
            "title": "Antiguedad Promedio Horas",
            "description": "Horas promedio desde la última verificación de cada producto contra la fuente.",
            "examples": [
              18.2
            ]
          },
          "total_productos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Productos",
            "description": "Productos válidos en la caché.",
            "examples": [
              1240
            ]
          }
        },
        "type": "object",
        "required": [
          "porcentaje_validos",
          "porcentaje_duplicados",
          "cobertura_ingredientes",
          "antiguedad_promedio_horas",
          "total_productos"
        ],
        "title": "MetricasCalidad"
      },
      "MetricasEvaluacion": {
        "properties": {
          "k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "K",
            "examples": [
              5
            ]
          },
          "precision_at_k": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Precision At K",
            "examples": [
              0.8
            ]
          },
          "recall_at_k": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Recall At K",
            "examples": [
              0.65
            ]
          },
          "consultas_evaluadas": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Consultas Evaluadas",
            "examples": [
              20
            ]
          },
          "tiempo_promedio_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Tiempo Promedio Ms",
            "examples": [
              14.3
            ]
          }
        },
        "type": "object",
        "required": [
          "k",
          "precision_at_k",
          "recall_at_k",
          "consultas_evaluadas",
          "tiempo_promedio_ms"
        ],
        "title": "MetricasEvaluacion"
      },
      "Procedencia": {
        "properties": {
          "fuente": {
            "type": "string",
            "const": "openfoodfacts",
            "title": "Fuente",
            "description": "Fuente web de la que proviene el producto.",
            "default": "openfoodfacts",
            "examples": [
              "openfoodfacts"
            ]
          },
          "url_fuente": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url Fuente",
            "description": "URL pública del producto en la fuente.",
            "examples": [
              "https://world.openfoodfacts.org/product/7802800716999"
            ]
          },
          "recuperado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Recuperado En",
            "description": "Momento de la descarga; se normaliza a UTC.",
            "examples": [
              "2026-10-20T14:30:00Z"
            ]
          },
          "modificado_en_fuente": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modificado En Fuente",
            "description": "Última modificación informada por la fuente, en UTC.",
            "examples": [
              "2026-09-02T08:15:00Z"
            ]
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id",
            "description": "Ejecución de ingesta que obtuvo el registro.",
            "examples": [
              "3f2b8c1e-9d4a-4e7b-8a6f-1c2d3e4f5a6b"
            ]
          },
          "hash_contenido": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Hash Contenido",
